{
  "id": "stratus",
  "providers": ["stratus"],
  "tools": ["stratus_embeddings", "stratus_rollout"],
  "skills": ["./skills/stratus-info"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable Stratus plugin"
      },
      "config": {
        "type": "object",
        "description": "Stratus plugin configuration",
        "properties": {
          "apiKey": {
            "type": "string",
            "description": "Stratus API key (optional — Formation pool used as fallback)"
          },
          "baseUrl": {
            "type": "string",
            "default": "https://api.stratus.run",
            "description": "Stratus API base URL"
          },
          "inlineKeys": {
            "type": "object",
            "description": "Optional BYOK keys passed per-request to bypass Formation pool",
            "properties": {
              "openai_key": {
                "type": "string",
                "description": "OpenAI API key for BYOK passthrough"
              },
              "anthropic_key": {
                "type": "string",
                "description": "Anthropic API key for BYOK passthrough"
              },
              "gemini_key": {
                "type": "string",
                "description": "Google Gemini API key for BYOK passthrough (also sent as X-Google-Key header)"
              }
            }
          },
          "provider": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "defaultModel": {
                "type": "string",
                "default": "stratus-x1ac-base-claude-sonnet-4-5"
              }
            }
          },
          "tools": {
            "type": "object",
            "properties": {
              "embeddings": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  }
                }
              },
              "rollout": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
